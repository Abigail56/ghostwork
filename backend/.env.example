# GhostWork API settings (copy to backend/.env). Never commit the real file.
APP_NAME=GhostWork API
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | test | production
DEBUG=false

# Must match POSTGRES_* in the root .env (port 5434 = Compose database).
DATABASE_URL=postgresql+psycopg://ghostwork:change_this_local_password@localhost:5434/ghostwork

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Production: COOKIE_SECURE is forced on. Use COOKIE_SAMESITE=none only if the
# frontend and API are on different sites (and then serve both over HTTPS).
COOKIE_SAMESITE=lax

REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Platform email (password reset, failure emails). Leave SMTP_HOST empty to disable.
# Local: Mailpit from docker-compose (inbox at http://localhost:8026).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GhostWork <no-reply@ghostwork.local>

# DEVELOPMENT ONLY. Lets workflows reach services on this machine (e.g. Mailpit).
# The API refuses to start with this enabled when ENVIRONMENT=production.
ALLOW_PRIVATE_NETWORK_REQUESTS=true

# Auth rate limits per client IP. Raise locally only for automated UI tests.
REGISTER_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_5_MIN=10
