# Docker Compose settings (copy to .env). Local development values only.
POSTGRES_DB=ghostwork
POSTGRES_USER=ghostwork
POSTGRES_PASSWORD=change_this_local_password

# Host ports. 5434/6380 avoid clashing with a system PostgreSQL/Redis.
POSTGRES_PORT=5434
REDIS_PORT=6380
MAIL_SMTP_PORT=1026
MAIL_UI_PORT=8026
